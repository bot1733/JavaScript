while (true) {
    let choice = prompt(
`Оберіть задачу:
1 - Сума чисел у діапазоні
2 - Найбільший спільний дільник
3 - Всі дільники числа
4 - Кількість цифр у числі
5 - Статистика для 10 чисел
6 - Калькулятор
7 - Зсув цифр числа
8 - Дні тижня
9 - Таблиця множення 2-9
10 - Гра "Вгадай число"
0 - Вийти`
    );

    if (choice === "0") break;

    switch (choice) {
        case "1":
            let start = parseInt(prompt("Введіть початок діапазону:"));
            let end = parseInt(prompt("Введіть кінець діапазону:"));
            let sum = 0;
            for (let i = start; i <= end; i++) sum += i;
            alert(`Сума всіх чисел від ${start} до ${end} = ${sum}`);
            break;

        case "2":
            let a = parseInt(prompt("Введіть перше число:"));
            let b = parseInt(prompt("Введіть друге число:"));
            function gcd(x, y) { while (y) { let t = y; y = x % y; x = t; } return x; }
            alert(`НСД: ${gcd(a, b)}`);
            break;

        case "3":
            let n = parseInt(prompt("Введіть число:"));
            let divisors = [];
            for (let i = 1; i <= n; i++) if (n % i === 0) divisors.push(i);
            alert(`Дільники ${n}: ${divisors.join(", ")}`);
            break;

        case "4":
            let numStr = prompt("Введіть число:");
            alert(`Кількість цифр: ${numStr.replace("-", "").length}`);
            break;

        case "5":
            let pos=0, neg=0, zero=0, even=0, odd=0;
            for (let i=0;i<10;i++){
                let num = parseInt(prompt(`Введіть число ${i+1}:`));
                if(num>0) pos++; else if(num<0) neg++; else zero++;
                if(num%2===0) even++; else odd++;
            }
            alert(`Додатні: ${pos}, Від'ємні: ${neg}, Нулі: ${zero}, Парні: ${even}, Непарні: ${odd}`);
            break;

        case "6":
            while(true){
                let x = parseFloat(prompt("Перше число:"));
                let y = parseFloat(prompt("Друге число:"));
                let op = prompt("Оператор (+,-,*,/):");
                let res;
                if(op=="+") res=x+y;
                else if(op=="-") res=x-y;
                else if(op=="*") res=x*y;
                else if(op=="/") res=x/y;
                else { alert("Невірний оператор!"); continue; }
                alert(`Результат: ${res}`);
                if(!confirm("Ще один приклад?")) break;
            }
            break;

        case "7":
            let number = prompt("Введіть число:");
            let shift = parseInt(prompt("На скільки цифр змістити?")) % number.length;
            let shifted = number.slice(shift) + number.slice(0, shift);
            alert(`Результат: ${shifted}`);
            break;

        case "8":
            const days = ["Понеділок","Вівторок","Середа","Четвер","П'ятниця","Субота","Неділя"];
            let i = 0;
            while(confirm(`${days[i]}. Бажаєте побачити наступний день?`)){
                i = (i+1)%7;
            }
            break;

        case "9":
            let table="";
            for(let i=2;i<=9;i++){
                table += `Таблиця множення ${i}:\n`;
                for(let j=1;j<=10;j++) table += `${i} x ${j} = ${i*j}\n`;
            }
            console.log(table);
            alert("Таблиця множення виведена в консоль.");
            break;

        case "10":
            let low=0, high=100;
            alert("Загадайте число від 0 до 100.");
            while(true){
                let mid = Math.floor((low+high)/2);
                let ans = prompt(`Ваше число > ${mid}, < ${mid}, або == ${mid}?`);
                if(ans=="=="){ alert(`Вітаю! Ваше число ${mid}`); break; }
                else if(ans==">") low=mid+1;
                else if(ans=="<") high=mid-1;
                else alert("Введіть >, < або ==");
            }
            break;

        default:
            alert("Невірний вибір!");
    }
}
