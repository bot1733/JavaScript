def gen(n):
    for i in range(1, n + 1):
        yield i * i


for x in gen(5):
    print(x)
//5
def most(lst):
    d = {}
    
    for i in lst:
        if i in d:
            d[i] += 1
        else:
            d[i] = 1
    
    return max(d, key=d.get)


print(most([1, 2, 2, 3, 3, 3, 4]))
